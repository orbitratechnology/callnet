# Use the native WebRTC transport for authenticated calls.
EXPO_PUBLIC_CALL_MODE=webrtc
EXPO_PUBLIC_SIGNALING_URL=wss://callnet-signaling.orbitra-technology.workers.dev

# Firebase client configuration. These values are public client settings, not
# service-account credentials. Never put admin credentials in the mobile app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
FIREBASE_PROJECT_ID=callnet-orbitra-20260902

# TURN credentials are fetched from the authenticated signaling Worker.
