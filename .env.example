# Use the native WebRTC transport for authenticated calls.
EXPO_PUBLIC_CALL_MODE=webrtc
EXPO_PUBLIC_SIGNALING_URL=http://127.0.0.1:8787

# Firebase client configuration. These values are public client settings, not
# service-account credentials. Never put admin credentials in the mobile app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=callnet-orbitra-20260902

# Optional Metered STUN/TURN fallback for development. Never commit real credentials.
EXPO_PUBLIC_TURN_URLS=stun:stun.relay.metered.ca:80,turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:80?transport=tcp,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=
