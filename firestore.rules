rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
// users/{uid}: uid, username, displayName, photoURL, createdAt, updatedAt.
//   Only non-sensitive profile fields are stored here. Email and auth
//   provider data remain in Firebase Authentication.
// usernames/{username}: uid.
//   This exact-key mapping supports known-username lookup without allowing
//   collection listing or a public directory.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidUsername(value) {
      return value is string &&
        value.size() >= 3 && value.size() <= 30 &&
        value.matches("^[a-z0-9](?:[a-z0-9._-]{1,28}[a-z0-9])?$");
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['uid', 'username', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.username is string && isValidUsername(data.username) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      // This collection contains only the public profile subset.
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidProfile(request.resource.data) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid;
      allow update: if isOwner(userId) &&
        isValidProfile(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (request.resource.data.username == resource.data.username ||
          getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid);
      allow delete: if false;
    }

    match /usernames/{username} {
      // Exact gets are allowed; listing the directory is intentionally denied.
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        isValidUsername(username) &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }
  }
}
