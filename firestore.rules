rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidPhoneNumber(value) {
      return value is string && value.matches("^\\+[1-9][0-9]{6,14}$");
    }

    function isValidProfile(data) {
      return data.keys().hasOnly([
          'uid', 'phoneNumber', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        isValidPhoneNumber(data.phoneNumber) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (data.email == null || (data.email is string && data.email.size() <= 320)) &&
        (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidProfile(request.resource.data) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/phoneDirectory/$(request.resource.data.phoneNumber)).data.uid == request.auth.uid;
      allow update: if isOwner(userId) &&
        isValidProfile(request.resource.data) &&
        resource.data.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        (!resource.data.keys().hasAny(['phoneNumber']) || request.resource.data.phoneNumber == resource.data.phoneNumber) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        getAfter(/databases/$(database)/documents/phoneDirectory/$(request.resource.data.phoneNumber)).data.uid == request.auth.uid;
      allow delete: if false;

      match /devices/{deviceId} {
        allow get, list: if false;
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['token', 'type', 'platform', 'updatedAt']) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() >= 1 &&
          request.resource.data.token.size() <= 4096 &&
          request.resource.data.type in ['APNS_VOIP', 'FCM'] &&
          request.resource.data.platform in ['ios', 'android'] &&
          request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId);
      }
    }

    match /phoneDirectory/{phoneNumber} {
      allow get, list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'uid', 'phoneHash', 'phoneNumber', 'displayName', 'email', 'photoURL', 'updatedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.phoneNumber == phoneNumber &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber == phoneNumber &&
        isValidPhoneNumber(request.resource.data.phoneNumber) &&
        request.resource.data.phoneHash is string &&
        request.resource.data.phoneHash.size() == 64 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1 &&
        request.resource.data.displayName.size() <= 80 &&
        (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 320)) &&
        (request.resource.data.photoURL == null || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048)) &&
        request.resource.data.updatedAt is timestamp;
      allow update: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'uid', 'phoneHash', 'phoneNumber', 'displayName', 'email', 'photoURL', 'updatedAt'
        ]) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.phoneNumber == phoneNumber &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber == phoneNumber &&
        isValidPhoneNumber(request.resource.data.phoneNumber) &&
        request.resource.data.phoneHash is string &&
        request.resource.data.phoneHash.size() == 64 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1 &&
        request.resource.data.displayName.size() <= 80 &&
        (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 320)) &&
        (request.resource.data.photoURL == null || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048)) &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
  }
}
